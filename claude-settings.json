{
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/Projects/claude_notify/claude-notify.sh 'input_required'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Projects/claude_notify/claude-notify.sh 'complete'"
          }
        ]
      }
    ]
  }
}
